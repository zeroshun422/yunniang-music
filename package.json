{
  "name": "yunniang-music",
  "version": "1.1.0",
  "description": "云娘音乐 — 网易云音乐 Linux 桌面客户端",
  "main": "dist-electron/main.js",
  "author": {
    "name": "yunniang",
    "email": "yunniang@example.com"
  },
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:shell\"",
    "dev:renderer": "vite",
    "dev:electron": "VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/build-electron.mjs --watch",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "start": "electron .",
    "dist": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm run build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux AppImage deb",
    "dist:deb": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm run build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux deb",
    "dist:appimage": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ npm run build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux AppImage",
    "typecheck": "tsc --noEmit",
    "dev:shell": "wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "pack:deb": "ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder --linux deb"
  },
  "dependencies": {
    "NeteaseCloudMusicApi": "4.32.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "45.3.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.25.12": true,
    "electron@45.3.1": true,
    "electron-winstaller@5.4.0": true
  },
  "homepage": "https://github.com/zeroshun422/yunniang-music#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroshun422/yunniang-music.git"
  },
  "bugs": {
    "url": "https://github.com/zeroshun422/yunniang-music/issues"
  },
  "keywords": [
    "netease",
    "netease-cloud-music",
    "linux",
    "electron",
    "music-player",
    "flac",
    "lossless"
  ],
  "desktopName": "yunniang-music.desktop"
}